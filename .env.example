# Client (Vite-exposed values are publishable only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Local UI testing only. Keep false or unset in production.
VITE_AUTH_DISABLED=false

# Server-only Supabase credentials — never expose these with VITE_
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public integrations
PIZZA_WEBHOOK_SECRET=
ALLOWED_ORIGINS=http://localhost:8080
# Default store used by the public menu endpoint when store_id is omitted.
PUBLIC_STORE_ID=

# Scheduled jobs (optional; required only when cron endpoints are enabled)
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
